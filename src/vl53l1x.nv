// vl53l1x — ST's VL53L1X long-distance time-of-flight ranging sensor, on its
// I2C bus, as devices-nv's `Rangefinder`, `RangefinderZones` and
// `Identifiable`.
//
// The documents: the datasheet "VL53L1X: A new generation, long distance
// ranging Time-of-Flight sensor based on ST's FlightSense technology",
// DocID031281 Rev 3 (November 2018, ST's DS12385), gives the address (0x52
// in write form, so 0x29), the 1.2 ms boot time, XSHUT and GPIO1, the
// distance modes (Table 4) and the three reference registers (Table 11):
// 0x010F reads 0xEA, 0x0110 reads 0xCC, 0x0111 reads 0x10.  The API user
// manual "VL53L1X API user manual", UM2356 (DocID031478 Rev 1, March
// 2018), gives the range status (Table 4), the timing budget, the region
// of interest and the three calibrations.  ST publishes no register map.
// The register list, the 91-byte default configuration and the sequences
// are those of ST's ultra-lite driver (STSW-IMG009), in the copy that
// stm32duino/VL53L1X carries under ST's BSD 3-clause licence, which names
// every register it touches.  Pololu's `vl53l1x-arduino` (MIT) was read
// as well, for the result block and the status mapping.
//
// Nothing is ported.  The code below is written from the sequences, in
// ST's order and with ST's values, and the registers the sheet does not
// name are named for what the ultra-lite driver calls them.  Where the
// ultra-lite driver does something this driver does not, the site says so.
//
// The register map as this driver uses it.  Registers are 16-bit
// addresses, sent high byte first; 16- and 32-bit values are most
// significant byte first at ascending addresses (Table 12):
//
//   0x0001  I2C_SLAVE__DEVICE_ADDRESS        the 7-bit address
//   0x0008  VHV_CONFIG__TIMEOUT_MACROP_LOOP_BOUND   0x09 two bounds, 0x81 full
//   0x000B  (unnamed)                        0x00 start VHV from the last
//                                            temperature, 0x92 from scratch
//   0x0016  ALGO__CROSSTALK_COMPENSATION_PLANE_OFFSET_KCPS   7.9 fixed point
//   0x0018  ..._X_PLANE_GRADIENT_KCPS, 0x001A ..._Y_PLANE_GRADIENT_KCPS
//   0x001E  ALGO__PART_TO_PART_RANGE_OFFSET_MM   signed, 2 fraction bits
//   0x0020  MM_CONFIG__INNER_OFFSET_MM, 0x0022 MM_CONFIG__OUTER_OFFSET_MM
//   0x002D..0x0087   the default configuration table (91 bytes), among it
//   0x002E  bit 0: the I2C pads pull up to AVDD instead of 1.8 V
//   0x0030  GPIO_HV_MUX__CTRL                bit 4: 0 active high, 1 low
//   0x0031  GPIO__TIO_HV_STATUS              bit 0: the interrupt state
//   0x0046  SYSTEM__INTERRUPT_CONFIG_GPIO    0x20 new sample ready, else the
//                                            threshold window in bits 2:0
//   0x004B  PHASECAL_CONFIG__TIMEOUT_MACROP  0x14 short mode, 0x0A long mode
//   0x005E  RANGE_CONFIG__TIMEOUT_MACROP_A   16 bits
//   0x0060  RANGE_CONFIG__VCSEL_PERIOD_A     0x0063 ..._B
//   0x0061  RANGE_CONFIG__TIMEOUT_MACROP_B   16 bits
//   0x0064  RANGE_CONFIG__SIGMA_THRESH       14.2 fixed point, mm
//   0x0066  RANGE_CONFIG__MIN_COUNT_RATE_RTN_LIMIT_MCPS   9.7 fixed point
//   0x0069  RANGE_CONFIG__VALID_PHASE_HIGH
//   0x006C  SYSTEM__INTERMEASUREMENT_PERIOD  32 bits, in oscillator ticks
//   0x0072  SYSTEM__THRESH_HIGH, 0x0074 SYSTEM__THRESH_LOW   16 bits, mm
//   0x0078  SD_CONFIG__WOI_SD0 (16 bits), 0x007A SD_CONFIG__INITIAL_PHASE_SD0
//   0x007F  ROI_CONFIG__USER_ROI_CENTRE_SPAD
//   0x0080  ROI_CONFIG__USER_ROI_REQUESTED_GLOBAL_XY_SIZE   (height-1)<<4 | (width-1)
//   0x0086  SYSTEM__INTERRUPT_CLEAR          write 0x01
//   0x0087  SYSTEM__MODE_START               0x40 start ranging, 0x00 stop
//   0x0089  RESULT__RANGE_STATUS             17 bytes: status at 0, stream
//                                            count at 2, effective SPADs (8.8)
//                                            at 3, ambient rate at 7, range in
//                                            mm at 13, signal rate at 15
//   0x00DE  RESULT__OSC_CALIBRATE_VAL        bits 9:0
//   0x00E5  FIRMWARE__SYSTEM_STATUS          non-zero once the part booted
//   0x010F  IDENTIFICATION__MODEL_ID         0xEA, 0xCC, then the revision
//   0x013E  ROI_CONFIG__MODE_ROI_CENTRE_SPAD the optical centre from the NVM
//
// The sequence of `start` is the ultra-lite driver's `SensorInit`: the model
// check, the wait for the boot, the 91-byte table, then one ranging with
// the default VHV calibration to settle the part, stopped again, and the
// VHV loop bound and the temperature register put back.
//
// Pitfalls the drivers read carry, and what is done here:
//
//   - The ultra-lite driver overwrites its status variable with every call,
//     so a part that stops answering half-way through the 91 register writes
//     reports success; and its I2C read loops until the part acknowledges.
//     Every transfer is checked, and every wait ends.
//   - Its `SensorInit` and temperature update spin on the data-ready flag
//     with no limit.  Every wait here has a timeout.
//   - Its distance-mode getter leaves the answer unset when the phase-calibration
//     register holds neither 0x14 nor 0x0A, and the budget setter then branches on
//     whatever the stack held.  `mode_read` answers `None` for that.
//   - Its distance-mode setter re-applies the old budget, which a 15 ms
//     budget (short mode only) makes fail silently when the new mode is long,
//     leaving the long-mode registers with the short-mode timeouts.  The
//     budget here steps to 33 ms when the new mode has no budget of the old size.
//   - Its inter-measurement setter multiplies by 1.075 and its getter divides
//     by 1.065, and the getter truncates the 32-bit register to 16 bits
//     before dividing.  Here both directions use 1.075 and the whole register.
//   - Its offset calibration adds up fifty 16-bit distances in a 16-bit
//     variable, which wraps from about 650 mm average, and reads the data-ready
//     flag through a variable it never sets first.  The sums here are
//     integers of full width and the flag is read each time.
//   - Its results are read register by register, so a distance and a status
//     can belong to two different measurements.  The 17 bytes from 0x0089 are
//     read in one transaction.
//   - Its threshold setter ORs the new window into the old one and never
//     clears the no-target bit; the register is written whole here.
//   - The 91-byte table overwrites 0x002E, so the 2.8 V I/O bit has to be
//     set after it and not before.
//   - Pololu marks a result whose stream count is 0 as "range valid, no wrap
//     check".  The ultra-lite driver does not look at the stream count; this
//     driver reports it in `Vl53Result.stream` and maps the status like the
//     ultra-lite driver does.

use embedded_hal.{ BoardI2c, BoardGpio, BoardTimer, I2cBus, GpioOut, Timer }
use dev_bus.{ DeviceWiring, DevBytes }
use dev_range.{ RangeReading, RangeStatus, Rangefinder, RangefinderZones }
use dev_id.{ DeviceId, Identifiable }

// The registers.
let REG_I2C_ADDRESS = 0x0001
let REG_VHV_LOOP_BOUND = 0x0008
let REG_VHV_TEMP = 0x000B
let REG_XTALK_OFFSET = 0x0016
let REG_XTALK_X = 0x0018
let REG_XTALK_Y = 0x001A
let REG_PART_OFFSET = 0x001E
let REG_INNER_OFFSET = 0x0020
let REG_OUTER_OFFSET = 0x0022
let REG_CONFIG = 0x002D
let REG_IO_SUPPLY = 0x002E
let REG_GPIO_CTRL = 0x0030
let REG_GPIO_STATUS = 0x0031
let REG_INT_CONFIG = 0x0046
let REG_PHASECAL = 0x004B
let REG_TIMEOUT_A = 0x005E
let REG_VCSEL_A = 0x0060
let REG_TIMEOUT_B = 0x0061
let REG_VCSEL_B = 0x0063
let REG_SIGMA = 0x0064
let REG_MIN_RATE = 0x0066
let REG_PHASE_HIGH = 0x0069
let REG_INTERMEASURE = 0x006C
let REG_THRESH_HIGH = 0x0072
let REG_THRESH_LOW = 0x0074
let REG_WOI = 0x0078
let REG_INITIAL_PHASE = 0x007A
let REG_ROI_CENTRE = 0x007F
let REG_ROI_SIZE = 0x0080
let REG_INT_CLEAR = 0x0086
let REG_MODE_START = 0x0087
let REG_RESULT = 0x0089
let REG_OSC = 0x00DE
let REG_BOOT = 0x00E5
let REG_MODEL = 0x010F
let REG_OPTICAL_CENTRE = 0x013E

// The model ID and module type of Table 11, read as one 16-bit value.
let MODEL_ID = 0xEACC

// SYSTEM__MODE_START.
let RANGING_START = 0x40
let RANGING_STOP = 0x00

// The phase-calibration timeout the two distance modes write.
let PHASECAL_SHORT = 0x14
let PHASECAL_LONG = 0x0A

// SYSTEM__INTERRUPT_CONFIG_GPIO: new sample ready, and the no-target bit.
let INT_NEW_SAMPLE = 0x20
let INT_NO_TARGET = 0x40

// VHV loop bounds: the working two-bound setting and the full re-calibration.
let VHV_TWO_BOUNDS = 0x09
let VHV_FULL = 0x81
let VHV_TEMP_FULL = 0x92

// The bus clock, I2C fast mode (datasheet: 400 kHz).
let I2C_HZ = 400000

// How long the driver waits, in milliseconds: for the boot (1.2 ms at most),
// for the first ranging of `start`, and for a result (the longest budget the
// driver sets is 500 ms; 1100 leaves room for an inter-measurement period).
let BOOT_MS = 2
let BOOT_WAIT_MS = 100
let CAL_WAIT_MS = 1000
let RESULT_WAIT_MS = 1100

// The most the part's register file holds in one write by this driver: a
// `DevBytes` holds 32 bytes, so the table goes in chunks of 30.
let CHUNK = 30

// The count of bytes in the default configuration and the distance modes'
// longest range, from Table 4 of the datasheet (white target, 100 ms, dark).
pub const CONFIG_LEN = 91
let SHORT_MAX_MM = 1360
let LONG_MAX_MM = 3600

// The budget `range_start` answers when the part's budget is not one the table
// knows, in microseconds: the longest the table has.
let FALLBACK_BUDGET_US = 500000

// The scale of the inter-measurement period, 1.075, as ST's driver has it.
let IM_NUM = 1075
let IM_DEN = 1000

// The calibrations average this many results.
let CAL_RESULTS = 50

// The region of interest.
let ROI_MIN = 4
let ROI_MAX = 16
let ROI_FULL_CENTRE = 199
let ZONE_SIDE = 4
let ZONE_COUNT = 16
let ZONE_SPAN = 4

// ST's default configuration, registers 0x2D to 0x87 in order
// (VL51L1X_DEFAULT_CONFIGURATION).  The comments in the ultra-lite driver
// call most of these bytes "not user-modifiable"; the ones it names are
// 0x2E and 0x2F (the I/O supply), 0x30 (interrupt polarity), 0x31, 0x46
// (interrupt configuration), 0x64 and 0x65 (the sigma threshold, 0x0168 =
// 90 mm in 14.2), 0x66 and 0x67 (the signal threshold, 0x0080 = 1 MCPS in
// 9.7), 0x6C to 0x6F (the inter-measurement period), 0x72 to 0x75 (the
// distance thresholds), 0x7F (the ROI centre, 0xC7 = 199), 0x80 (the ROI
// size, 0xFF = 16 by 16), 0x86 (the interrupt clear) and 0x87 (the start).
pub const DEFAULT_CONFIG = [
    0x00, 0x00, 0x00, 0x01, 0x02, 0x00, 0x02, 0x08, 0x00, 0x08, 0x10, 0x01, 0x01, 0x00, 0x00,
    0x00, 0x00, 0xFF, 0x00, 0x0F, 0x00, 0x00, 0x00, 0x00, 0x00, 0x20, 0x0B, 0x00, 0x00, 0x02,
    0x0A, 0x21, 0x00, 0x00, 0x05, 0x00, 0x00, 0x00, 0x00, 0xC8, 0x00, 0x00, 0x38, 0xFF, 0x01,
    0x00, 0x08, 0x00, 0x00, 0x01, 0xCC, 0x0F, 0x01, 0xF1, 0x0D, 0x01, 0x68, 0x00, 0x80, 0x08,
    0xB8, 0x00, 0x00, 0x00, 0x00, 0x0F, 0x89, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01,
    0x0F, 0x0D, 0x0E, 0x0E, 0x00, 0x00, 0x02, 0xC7, 0xFF, 0x9B, 0x00, 0x00, 0x00, 0x01, 0x00,
    0x00
]

// The distance modes of the ultra-lite driver (`SetDistanceMode` 1 and 2).  The
// part has a medium mode too, which that driver does not set.
pub @value
enum Vl53Mode
    Vl53Short
    Vl53Long

// The conditions of the distance threshold interrupt
// (`SetDistanceThreshold`'s window): below the low threshold, above the high
// one, outside the window or inside it.
pub @value
enum Vl53Window
    WindowBelow
    WindowAbove
    WindowOut
    WindowIn

// The state the driver keeps: whether continuous ranging runs.
pub @value
struct Vl53State
    continuous: Bool

// A result block as the part holds it: the raw status (bits 4:0 of
// RESULT__RANGE_STATUS), the stream count, the effective SPADs (the register
// is 8.8 fixed point; this is the whole count), the ambient and signal rates
// in kilo-counts a second (the registers times 8), and the range in
// millimetres before the status is applied.
pub @value
struct Vl53Result
    raw_status: Int
    stream: Int
    spads: Int
    ambient_kcps: Int
    signal_kcps: Int
    range_mm: Int

// The region of interest as the part holds it: the width and height in SPADs,
// 4 to 16, and the centre SPAD number of the table in `spad_of`.
pub @value
struct Vl53Roi
    w: Int
    h: Int
    centre: Int

// The sums of a calibration run: the results taken and their totals.
@value
struct Vl53Sums
    got: Int
    dist: Int
    signal: Int
    spads: Int

// A bus the part is on: `setup` makes it ready, `read_regs` and `write_regs`
// move bytes from and to consecutive registers (16-bit addresses) in one
// transaction, `now_ms` and `wait_ms` are the clock, `irq_level` is the level
// of GPIO1 and `xshut` drives the shutdown pin.
pub trait Vl53l1xPort
    fn setup(self) -> Bool [hw]
    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
    fn write_regs(self, reg: Int, src: DevBytes) -> Bool [hw]
    fn now_ms(self) -> Int [hw]
    fn wait_ms(self, ms: Int) [hw]
    fn irq_level(self) -> Int [hw]
    fn xshut(self, level: Int) -> Bool [hw]

// ── The bus ──────────────────────────────────────────────────────────

// Reads `n` bytes from the 16-bit register `reg` into `dst` in one transaction:
// whether the part answered.
pub fn i2c_read_into<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, n: Int,
                                var dst: DevBytes) -> Bool [hw]
    dev_bus.wiring_read16_into(bus, w, reg, n, var dst)

// Writes the bytes of `src` from the 16-bit register `reg` in one transaction:
// whether the part acknowledged.
pub fn i2c_write_from<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, src: DevBytes) -> Bool [hw]
    dev_bus.wiring_write16_from(bus, w, reg, src)

// Makes the bus ready: GPIO1 an input, XSHUT an output, the bus at 400 kHz.
// Answers whether the wiring has an address.
pub fn i2c_setup<B: I2cBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    if let Some(irq) = w.irq
        gpio.mode(irq, 0)
    if let Some(en) = w.en
        gpio.mode(en, 1)
    bus.init(I2C_HZ)
    w.addr != None

// The level of GPIO1 on the board, or -1 for a wiring with no interrupt pin.
pub fn irq_level_of<G: GpioOut>(gpio: G, w: DeviceWiring) -> Int [hw]
    let Some(irq) = w.irq else return -1
    gpio.get(irq)

// Drives the shutdown pin: whether the wiring has one.
pub fn xshut_of<G: GpioOut>(gpio: G, w: DeviceWiring, level: Int) -> Bool [hw]
    let Some(en) = w.en else return false
    gpio.set(en, level)
    true

// ── Register access ──────────────────────────────────────────────────

// One register, or `None` when the part did not answer.
pub fn rd<P: Vl53l1xPort>(p: P, reg: Int) -> ?Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(reg, 1, var b)
        return None
    Some(b[0] as Int)

// A 16-bit value, most significant byte first.
pub fn rd16<P: Vl53l1xPort>(p: P, reg: Int) -> ?Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(reg, 2, var b)
        return None
    Some((b[0] as Int << 8) | b[1] as Int)

// A 32-bit value, most significant byte first.
pub fn rd32<P: Vl53l1xPort>(p: P, reg: Int) -> ?Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(reg, 4, var b)
        return None
    Some((b[0] as Int << 24) | (b[1] as Int << 16) | (b[2] as Int << 8) | b[3] as Int)

// Writes one register: whether the part acknowledged.
pub fn wr<P: Vl53l1xPort>(p: P, reg: Int, v: Int) -> Bool [hw]
    var src: DevBytes = Vec.new()
    let _ = src.push((v & 0xFF) as u8)
    p.write_regs(reg, src)

// Writes a 16-bit value, most significant byte first.
pub fn wr16<P: Vl53l1xPort>(p: P, reg: Int, v: Int) -> Bool [hw]
    var src: DevBytes = Vec.new()
    let _ = src.push(((v >> 8) & 0xFF) as u8)
    let _ = src.push((v & 0xFF) as u8)
    p.write_regs(reg, src)

// Writes a 32-bit value, most significant byte first.
pub fn wr32<P: Vl53l1xPort>(p: P, reg: Int, v: Int) -> Bool [hw]
    var src: DevBytes = Vec.new()
    let _ = src.push(((v >> 24) & 0xFF) as u8)
    let _ = src.push(((v >> 16) & 0xFF) as u8)
    let _ = src.push(((v >> 8) & 0xFF) as u8)
    let _ = src.push((v & 0xFF) as u8)
    p.write_regs(reg, src)

// Sets the bits of `mask` in `reg` to `bits`, leaving the others.
pub fn upd<P: Vl53l1xPort>(p: P, reg: Int, mask: Int, bits: Int) -> Bool [hw]
    let Some(old) = rd(p, reg) else return false
    wr(p, reg, (old & (0xFF ^ mask)) | (bits & mask))

// ── Identity and boot ────────────────────────────────────────────────

// The part's identity: the model ID and module type as one 16-bit value
// (0xEACC, Table 11) and the mask revision register, or `None` for a part that
// did not answer or answered as another part (the VL53L4CD reads 0xEBAA).
pub fn id_read<P: Vl53l1xPort>(p: P) -> ?DeviceId [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(REG_MODEL, 3, var b)
        return None
    let who = (b[0] as Int << 8) | b[1] as Int
    if who != MODEL_ID
        return None
    Some(DeviceId { who: who, rev: Some(b[2] as Int) })

// Whether the model ID and module type read 0xEACC.
pub fn model_ok<P: Vl53l1xPort>(p: P) -> Bool [hw]
    id_read(p) != None

// Polls FIRMWARE__SYSTEM_STATUS until the part reports it booted, for at most
// `BOOT_WAIT_MS`.  The register is read at least once.
pub fn boot_wait<P: Vl53l1xPort>(p: P) -> Bool [hw]
    let start = p.now_ms()
    loop
        let Some(v) = rd(p, REG_BOOT) else return false
        if v != 0
            return true
        if p.now_ms() - start >= BOOT_WAIT_MS
            return false

// Cycles the shutdown pin when the wiring has one: low, then high, with the
// booting time after each (the datasheet gives 1.2 ms at most).  The part comes
// back at address 0x29.  Answers whether the wiring has the pin.
pub fn reset_cycle<P: Vl53l1xPort>(p: P) -> Bool [hw]
    if not p.xshut(0)
        return false
    p.wait_ms(BOOT_MS)
    let _up = p.xshut(1)
    p.wait_ms(BOOT_MS)
    true

// ── The interrupt, the data-ready flag, ranging ──────────────────────

// Whether a result waits.  GPIO_HV_MUX__CTRL bit 4 says which level the
// interrupt takes (0 high), and GPIO__TIO_HV_STATUS bit 0 is the state; a
// result waits when the state equals the level.  Both come in one transaction.
pub fn data_ready<P: Vl53l1xPort>(p: P) -> Bool [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(REG_GPIO_CTRL, 2, var b)
        return false
    var level = 1
    if ((b[0] as Int >> 4) & 1) == 1
        level = 0
    ((b[1] as Int) & 1) == level

// Polls the data-ready flag for at most `timeout_ms`.  The flag is read at
// least once.  A poll the part does not answer counts as "not ready" and is
// tried again, so one lost transfer does not end the wait; a part that stays
// silent ends it at the timeout.
pub fn ready_wait<P: Vl53l1xPort>(p: P, timeout_ms: Int) -> Bool [hw]
    let start = p.now_ms()
    loop
        if data_ready(p)
            return true
        if p.now_ms() - start >= timeout_ms
            return false

// Clears the interrupt, which lets the next ranging update the result.
pub fn interrupt_clear<P: Vl53l1xPort>(p: P) -> Bool [hw]
    wr(p, REG_INT_CLEAR, 0x01)

// Starts autonomous ranging (SYSTEM__MODE_START = 0x40): whether the part
// acknowledged.
pub fn ranging_start<P: Vl53l1xPort>(p: P) -> Bool [hw]
    wr(p, REG_MODE_START, RANGING_START)

// Stops ranging (SYSTEM__MODE_START = 0x00): whether the part acknowledged.
pub fn ranging_stop<P: Vl53l1xPort>(p: P) -> Bool [hw]
    wr(p, REG_MODE_START, RANGING_STOP)

// The interrupt polarity: `Some(true)` for active high (the default).
pub fn polarity_read<P: Vl53l1xPort>(p: P) -> ?Bool [hw]
    let Some(v) = rd(p, REG_GPIO_CTRL) else return None
    Some(((v >> 4) & 1) == 0)

// Sets the interrupt polarity, active high when `high`: whether the part took
// the write.
pub fn polarity_write<P: Vl53l1xPort>(p: P, high: Bool) -> Bool [hw]
    var bit = 0x10
    if high
        bit = 0
    upd(p, REG_GPIO_CTRL, 0x10, bit)

// The VHV calibration cycle of `SensorInit` (and, with `full`, of the
// temperature update): one ranging, waited for, cleared and stopped, then the
// loop bound and the temperature register put back.  `full` first asks for
// the complete VHV search.  The ranging is stopped and the registers are put
// back whatever happened inside.
pub fn vhv_cycle<P: Vl53l1xPort>(p: P, full: Bool) -> Bool [hw]
    var ok = true
    if full
        ok = wr(p, REG_VHV_LOOP_BOUND, VHV_FULL) and wr(p, REG_VHV_TEMP, VHV_TEMP_FULL)
    if ok
        ok = ranging_start(p) and ready_wait(p, CAL_WAIT_MS) and interrupt_clear(p)
    let stopped = ranging_stop(p)
    let back = wr(p, REG_VHV_LOOP_BOUND, VHV_TWO_BOUNDS) and wr(p, REG_VHV_TEMP, 0x00)
    ok and stopped and back

// ── The initialisation ───────────────────────────────────────────────

// Writes the 91-byte default configuration to 0x2D..0x87 in bursts of at most
// 30 bytes.
pub fn config_write<P: Vl53l1xPort>(p: P) -> Bool [hw]
    for chunk in 0..4
        let base = chunk * CHUNK
        var n = CONFIG_LEN - base
        if n > CHUNK
            n = CHUNK
        if n > 0
            var src: DevBytes = Vec.new()
            for i in 0..n
                let _ = src.push(DEFAULT_CONFIG[base + i] as u8)
            if not p.write_regs(REG_CONFIG + base, src)
                return false
    true

// Brings the part up (`SensorInit`): the model check, the wait for the boot,
// the table, the I/O supply (bit 0 of 0x2E set for the breakouts that pull
// the bus up to AVDD) and one VHV cycle.  The part comes up in long
// distance mode with a 100 ms budget, the table's own.
pub fn start<P: Vl53l1xPort>(p: P, io_2v8: Bool) -> Bool [hw]
    if not (model_ok(p) and boot_wait(p) and config_write(p))
        return false
    if io_2v8
        if not upd(p, REG_IO_SUPPLY, 0x01, 0x01)
            return false
    vhv_cycle(p, false)

// Makes the bus ready, cycles the shutdown pin if there is one, and brings the
// part up with `start`.
pub fn bring_up<P: Vl53l1xPort>(p: P, io_2v8: Bool) -> Bool [hw]
    if not p.setup()
        return false
    let _cycled = reset_cycle(p)
    start(p, io_2v8)

// One full VHV search, which the datasheet asks after a large change of
// temperature (`StartTemperatureUpdate`).
pub fn temperature_update<P: Vl53l1xPort>(p: P) -> Bool [hw]
    vhv_cycle(p, true)

// ── The timing budget and the inter-measurement period ───────────────

// The timeout registers (A, then B) for a budget in milliseconds in a mode, as
// ST's tables have them, packed as A in the high 16 bits and B in the low
// ones; -1 for a budget the mode has no row for.  15 ms is short mode only,
// and the datasheet allows 20 ms in short mode only (§ 2.5.2), so the long
// table has no 20 ms row although the ultra-lite driver writes one.
pub fn budget_words(mode: Vl53Mode, ms: Int) -> Int
    match mode
        Vl53Short =>
            if ms == 15
                return (0x001D << 16) | 0x0027
            if ms == 20
                return (0x0051 << 16) | 0x006E
            if ms == 33
                return (0x00D6 << 16) | 0x006E
            if ms == 50
                return (0x01AE << 16) | 0x01E8
            if ms == 100
                return (0x02E1 << 16) | 0x0388
            if ms == 200
                return (0x03E1 << 16) | 0x0496
            if ms == 500
                return (0x0591 << 16) | 0x05C1
            -1
        Vl53Long =>
            if ms == 33
                return (0x0060 << 16) | 0x006E
            if ms == 50
                return (0x00AD << 16) | 0x00C6
            if ms == 100
                return (0x01CC << 16) | 0x01EA
            if ms == 200
                return (0x02D9 << 16) | 0x02F8
            if ms == 500
                return (0x048F << 16) | 0x04A4
            -1

// The budget in milliseconds the timeout register A means, or 0 for a value
// the tables do not hold.  The values of the two modes do not overlap.
pub fn budget_ms_of_word(a: Int) -> Int
    if a == 0x001D
        return 15
    if a == 0x0051 or a == 0x001E
        return 20
    if a == 0x00D6 or a == 0x0060
        return 33
    if a == 0x01AE or a == 0x00AD
        return 50
    if a == 0x02E1 or a == 0x01CC
        return 100
    if a == 0x03E1 or a == 0x02D9
        return 200
    if a == 0x0591 or a == 0x048F
        return 500
    0

// The distance mode the part is in, from the phase-calibration timeout, or
// `None` when that holds neither mode's value or the part did not answer.
pub fn mode_read<P: Vl53l1xPort>(p: P) -> ?Vl53Mode [hw]
    let Some(v) = rd(p, REG_PHASECAL) else return None
    if v == PHASECAL_SHORT
        return Some(Vl53Mode.Vl53Short)
    if v == PHASECAL_LONG
        return Some(Vl53Mode.Vl53Long)
    None

// The timing budget in milliseconds, `None` when the part did not answer, 0 for
// a budget the tables do not have.
pub fn budget_get<P: Vl53l1xPort>(p: P) -> ?Int [hw]
    let Some(a) = rd16(p, REG_TIMEOUT_A) else return None
    Some(budget_ms_of_word(a))

// The timing budget in milliseconds, 0 when the part did not answer or holds a
// budget the tables do not have.
pub fn budget_read<P: Vl53l1xPort>(p: P) -> Int [hw]
    budget_get(p) ?? 0

// Sets the budget to a row of the current mode's table.  Answers false for a
// budget the mode has no row for, for a part in no known mode, and when the
// part did not take the writes.  The budget must not be changed while the
// part is ranging.
pub fn budget_write<P: Vl53l1xPort>(p: P, ms: Int) -> Bool [hw]
    let Some(mode) = mode_read(p) else return false
    let w = budget_words(mode, ms)
    if w < 0
        return false
    wr16(p, REG_TIMEOUT_A, (w >> 16) & 0xFFFF) and wr16(p, REG_TIMEOUT_B, w & 0xFFFF)

// The budget a new mode keeps from the old one: the same size when the new
// mode has a row for it, else 33 ms, the least that works in every mode; 100
// ms when the old budget was not one the tables know.
pub fn budget_for_mode(old_ms: Int, mode: Vl53Mode) -> Int
    if old_ms == 0
        return 100
    if budget_words(mode, old_ms) < 0
        return 33
    old_ms

// Sets the distance mode (`SetDistanceMode`): the VCSEL periods, the valid
// phase, the sigma-detector windows and the phase-calibration timeout of the
// mode, then the budget put back.  Answers whether the part took every write.
pub fn mode_write<P: Vl53l1xPort>(p: P, mode: Vl53Mode) -> Bool [hw]
    let Some(old) = budget_get(p) else return false
    var ok = false
    match mode
        Vl53Short =>
            ok = wr(p, REG_PHASECAL, PHASECAL_SHORT) and wr(p, REG_VCSEL_A, 0x07) and wr(p, REG_VCSEL_B, 0x05) and wr(p, REG_PHASE_HIGH, 0x38) and wr16(p, REG_WOI, 0x0705) and wr16(p, REG_INITIAL_PHASE, 0x0606)
        Vl53Long =>
            ok = wr(p, REG_PHASECAL, PHASECAL_LONG) and wr(p, REG_VCSEL_A, 0x0F) and wr(p, REG_VCSEL_B, 0x0D) and wr(p, REG_PHASE_HIGH, 0xB8) and wr16(p, REG_WOI, 0x0F0D) and wr16(p, REG_INITIAL_PHASE, 0x0E0E)
    ok and budget_write(p, budget_for_mode(old, mode))

// The inter-measurement period in milliseconds, 0 when the part did not
// answer or its oscillator value reads 0.  The register is in oscillator
// ticks: `RESULT__OSC_CALIBRATE_VAL` (bits 9:0) times the period times 1.075.
pub fn intermeasure_read<P: Vl53l1xPort>(p: P) -> Int [hw]
    let Some(osc) = rd16(p, REG_OSC) else return 0
    let Some(ticks) = rd32(p, REG_INTERMEASURE) else return 0
    let denom = (osc & 0x3FF) * IM_NUM
    if denom == 0
        return 0
    ticks * IM_DEN / denom

// Sets the period, 1 to 65535 ms.  A period shorter than the budget makes the
// part range back to back.  Answers false for a period out of range, for an
// oscillator value of 0, and when the part did not take the write.
pub fn intermeasure_write<P: Vl53l1xPort>(p: P, ms: Int) -> Bool [hw]
    if ms < 1 or ms > 65535
        return false
    let Some(osc) = rd16(p, REG_OSC) else return false
    let clock = osc & 0x3FF
    if clock == 0
        return false
    wr32(p, REG_INTERMEASURE, clock * ms * IM_NUM / IM_DEN)

// ── Limits and thresholds ────────────────────────────────────────────

// The minimum signal rate for a valid range, in kilo-counts a second: the
// register is MCPS in 9.7 fixed point and the ultra-lite driver's unit is the
// register times 8.
pub fn signal_limit_read<P: Vl53l1xPort>(p: P) -> Int [hw]
    let Some(v) = rd16(p, REG_MIN_RATE) else return -1
    v << 3

// Sets the signal limit in kilo-counts a second, 0 to 524,280 (the register is
// the value over 8): false for a value outside that or a part that did not take it.
pub fn signal_limit_write<P: Vl53l1xPort>(p: P, kcps: Int) -> Bool [hw]
    if kcps < 0 or kcps > 0x7FFF8
        return false
    wr16(p, REG_MIN_RATE, kcps >> 3)

// The maximum sigma for a valid range, in millimetres: the register is 14.2
// fixed point, so it holds up to 16383 mm.
pub fn sigma_limit_read<P: Vl53l1xPort>(p: P) -> Int [hw]
    let Some(v) = rd16(p, REG_SIGMA) else return -1
    v >> 2

// Sets the sigma limit in millimetres, 0 to 16383: false for a value outside that
// or a part that did not take it.
pub fn sigma_limit_write<P: Vl53l1xPort>(p: P, mm: Int) -> Bool [hw]
    if mm < 0 or mm > 0x3FFF
        return false
    wr16(p, REG_SIGMA, mm << 2)

// The code a window takes in SYSTEM__INTERRUPT_CONFIG_GPIO bits 2:0.
pub fn window_code(w: Vl53Window) -> Int
    match w
        WindowBelow => 0
        WindowAbove => 1
        WindowOut => 2
        WindowIn => 3

// Arms the distance threshold interrupt (`SetDistanceThreshold`): the window,
// whether it also fires with no target, and the two thresholds in millimetres.
// The new-sample-ready setting of the interrupt is replaced;
// `interrupt_new_sample` restores it.  The register is written whole: the
// ultra-lite driver reads it and ORs the new window into the old one, so
// "inside" (3) followed by "outside" (2) leaves 3, and a no-target bit once
// set is never cleared.
pub fn threshold_write<P: Vl53l1xPort>(p: P, low: Int, high: Int, w: Vl53Window,
                                       no_target: Bool) -> Bool [hw]
    if low < 0 or low > 0xFFFF or high < 0 or high > 0xFFFF
        return false
    var cfg = window_code(w)
    if no_target
        cfg = cfg | INT_NO_TARGET
    wr(p, REG_INT_CONFIG, cfg) and wr16(p, REG_THRESH_HIGH, high) and wr16(p, REG_THRESH_LOW, low)

// Puts the interrupt back to "new sample ready", the table's own setting.
pub fn interrupt_new_sample<P: Vl53l1xPort>(p: P) -> Bool [hw]
    wr(p, REG_INT_CONFIG, INT_NEW_SAMPLE)

// ── The region of interest ───────────────────────────────────────────

// The SPAD number at column `col` and row `row` of the 16 by 16 array, in the
// numbering of the datasheet's figure (as Pololu's header draws the table from
// ST's UM2555): the top half, rows 0 to 7, counts down each column from
// 128 + 8 col; the bottom half counts from 127 - 8 col.  The default centre,
// 199, is column 8, row 7.  -1 for a SPAD outside the array.
pub fn spad_of(col: Int, row: Int) -> Int
    if col < 0 or col > 15 or row < 0 or row > 15
        return -1
    if row < 8
        return 128 + row + 8 * col
    127 - (row - 8) - 8 * col

// The centre SPAD of a region of `w` by `h` SPADs whose top left SPAD is at
// column `col0`, row `row0`.  The array's own centre is column 8, row 7 for
// 16 by 16 (SPAD 199); this takes the same offsets, half the width and half the
// height less one, for every size.  That offset for sizes other than 16 by
// 16 is NOT VERIFIED.
pub fn roi_centre_of(col0: Int, row0: Int, w: Int, h: Int) -> Int
    spad_of(col0 + w / 2, row0 + h / 2 - 1)

// The region the part is set to.
pub fn roi_read<P: Vl53l1xPort>(p: P) -> ?Vl53Roi [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(REG_ROI_CENTRE, 2, var b)
        return None
    let size = b[1] as Int
    Some(Vl53Roi { w: (size & 0x0F) + 1, h: ((size >> 4) & 0x0F) + 1, centre: b[0] as Int })

// Sets the region in one write.  Answers false for a size outside 4 to 16
// (UM2356 § 2.5.6: the least is 4 by 4) or a centre outside 0 to 255.
pub fn roi_write<P: Vl53l1xPort>(p: P, r: Vl53Roi) -> Bool [hw]
    if r.w < ROI_MIN or r.w > ROI_MAX or r.h < ROI_MIN or r.h > ROI_MAX
        return false
    if r.centre < 0 or r.centre > 255
        return false
    var src: DevBytes = Vec.new()
    let _ = src.push(r.centre as u8)
    let _ = src.push((((r.h - 1) << 4) | (r.w - 1)) as u8)
    p.write_regs(REG_ROI_CENTRE, src)

// Sets the size as the ultra-lite driver's `SetROI` does: the centre goes back to
// the part's optical centre (the NVM register 0x013E), and to 199 for a region
// wider or taller than 10.
pub fn roi_size_write<P: Vl53l1xPort>(p: P, w: Int, h: Int) -> Bool [hw]
    let Some(optical) = rd(p, REG_OPTICAL_CENTRE) else return false
    var centre = optical
    if w > 10 or h > 10
        centre = ROI_FULL_CENTRE
    roi_write(p, Vl53Roi { w: w, h: h, centre: centre })

// ── The result ───────────────────────────────────────────────────────

// The status the datasheet's maps give for a raw status code (bits 4:0 of
// RESULT__RANGE_STATUS).  9 is a good range.  6 (sigma) and 4 (signal) are the
// part's own confidence limits, a range with a warning.  5, 7 and 8 are the
// phase checks and the minimum clip: a target beyond the unambiguous range or
// nearer than the least the part can tell, with no distance.  1, 2, 3 and 17
// are hardware faults (UM2356 Table 4: 5).  12 (the ignore threshold), 13
// (the region clipped) and the rest read "no update".
pub fn status_of_raw(raw: Int) -> RangeStatus
    if raw == 9
        return RangeStatus.RangeValid
    if raw == 6 or raw == 4
        return RangeStatus.RangeWeak
    if raw == 5 or raw == 7 or raw == 8
        return RangeStatus.RangeOutOfRange
    if raw == 1 or raw == 2 or raw == 3 or raw == 17
        return RangeStatus.RangeFault
    RangeStatus.RangeNoTarget

// The status number UM2356 Table 4 gives, by the mapping of the ultra-lite
// driver's `GetRangeStatus`; 255 for a code it does not list.
pub fn uld_status_of_raw(raw: Int) -> Int
    if raw == 9
        return 0
    if raw == 6
        return 1
    if raw == 4
        return 2
    if raw == 8
        return 3
    if raw == 5
        return 4
    if raw == 3
        return 5
    if raw == 19
        return 6
    if raw == 7
        return 7
    if raw == 12
        return 9
    if raw == 18
        return 10
    if raw == 22
        return 11
    if raw == 23
        return 12
    if raw == 13
        return 13
    255

// The reading for a raw status and a range: a status that carries no
// distance reads 0 mm.
pub fn reading_of(raw: Int, range_mm: Int) -> RangeReading
    let st = status_of_raw(raw)
    if st == RangeStatus.RangeValid or st == RangeStatus.RangeWeak
        return RangeReading { mm: range_mm, status: st }
    RangeReading { mm: 0, status: st }

// The result block in one transaction (the 17 bytes from 0x89), then the
// interrupt cleared: `None` when the part did not answer or did not take the
// clear.
pub fn result_read<P: Vl53l1xPort>(p: P) -> ?Vl53Result [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(REG_RESULT, 17, var b)
        return None
    if not interrupt_clear(p)
        return None
    Some(Vl53Result {
        raw_status: (b[0] as Int) & 0x1F,
        stream: b[2] as Int,
        spads: ((b[3] as Int << 8) | b[4] as Int) >> 8,
        ambient_kcps: ((b[7] as Int << 8) | b[8] as Int) * 8,
        signal_kcps: ((b[15] as Int << 8) | b[16] as Int) * 8,
        range_mm: (b[13] as Int << 8) | b[14] as Int
    })

// Waits for a result, at most 1.1 s, and reads it.
pub fn result_wait<P: Vl53l1xPort>(p: P) -> ?Vl53Result [hw]
    if not ready_wait(p, RESULT_WAIT_MS)
        return None
    result_read(p)

// One measurement: the interrupt cleared, ranging started, the result waited
// for and read, ranging stopped.  The stop is attempted whatever happened.
pub fn measure<P: Vl53l1xPort>(p: P) -> ?Vl53Result [hw]
    var r: ?Vl53Result = None
    if interrupt_clear(p) and ranging_start(p)
        r = result_wait(p)
    let _stopped = ranging_stop(p)
    r

// What `range_start` answers: 0 while the part ranges continuously, else the
// budget in microseconds after a start, or -1.
pub fn range_start_of<P: Vl53l1xPort>(p: P, st: Vl53State) -> Int [hw]
    if st.continuous
        return 0
    if not (interrupt_clear(p) and ranging_start(p))
        return -1
    let ms = budget_read(p)
    if ms == 0
        return FALLBACK_BUDGET_US
    ms * 1000

// What `range_read` does: waits for the result and reads it as a reading.  A
// measurement that `range_start` began is stopped after its result, whatever
// that was; continuous ranging goes on.
pub fn range_read_of<P: Vl53l1xPort>(p: P, st: Vl53State) -> ?RangeReading [hw]
    let r = result_wait(p)
    if not st.continuous
        let _stopped = ranging_stop(p)
    let Some(x) = r else return None
    Some(reading_of(x.raw_status, x.range_mm))

// The longest distance the part is set to report, in millimetres: the dark
// figures of datasheet Table 4 for the mode; 0 when the part did not answer.
pub fn max_mm_of<P: Vl53l1xPort>(p: P) -> Int [hw]
    match mode_read(p)
        Some(m) =>
            if m == Vl53Mode.Vl53Short
                return SHORT_MAX_MM
            LONG_MAX_MM
        None => 0

// ── The zones ────────────────────────────────────────────────────────

// Measures the 16 zones of a 4 by 4 grid, each a 4 by 4 region of the array,
// one after the other, row-major, and replaces `out` with the readings.  The
// region the part was set to is put back afterwards.  The zone (row, column)
// is the region whose top left SPAD is at column 4 * column, row 4 * row of
// the numbering in `spad_of`; the lens inverts the scene, so the grid is the
// mirror image of what is in front of the part.  Answers false, with `out`
// empty, when a zone did not measure or the region could not be put back.
pub fn zones_scan<P: Vl53l1xPort>(p: P, var out: Vec[RangeReading; 64]) -> Bool [hw]
    out.clear()
    let Some(saved) = roi_read(p) else return false
    var ok = true
    for z in 0..ZONE_COUNT
        if ok
            let row = z / ZONE_SIDE
            let col = z % ZONE_SIDE
            let c = roi_centre_of(col * ZONE_SPAN, row * ZONE_SPAN, ZONE_SPAN, ZONE_SPAN)
            if roi_write(p, Vl53Roi { w: ZONE_SPAN, h: ZONE_SPAN, centre: c })
                match measure(p)
                    Some(r) =>
                        let _ = out.push(reading_of(r.raw_status, r.range_mm))
                    None => ok = false
            else
                ok = false
    let back = roi_write(p, saved)
    if not ok or not back
        out.clear()
    ok and back

// What `zones_start` answers: -1 while the part ranges continuously (a scan
// moves the region and stops ranging) or when it does not answer, else 16
// budgets in microseconds.
pub fn zones_start_of<P: Vl53l1xPort>(p: P, st: Vl53State) -> Int [hw]
    if st.continuous
        return -1
    let ms = budget_read(p)
    if ms == 0
        return -1
    ms * 1000 * ZONE_COUNT

// What `zones_read` does: the scan of `zones_scan`, refused with `out` empty
// while the part ranges continuously.
pub fn zones_read_of<P: Vl53l1xPort>(p: P, st: Vl53State, var out: Vec[RangeReading; 64]) -> Bool [hw]
    if st.continuous
        out.clear()
        return false
    zones_scan(p, var out)

// ── The calibrations ─────────────────────────────────────────────────

// Floor-free division toward zero, as C does it.
pub fn div_trunc(a: Int, b: Int) -> Int
    if a < 0
        return 0 - ((0 - a) / b)
    a / b

// The offset in millimetres: the register holds it with two fraction bits in
// 13 bits two's complement.
pub fn offset_read<P: Vl53l1xPort>(p: P) -> ?Int [hw]
    let Some(v) = rd16(p, REG_PART_OFFSET) else return None
    Some(div_trunc(dev_bus.dev_sign_extend(v, 13), 4))

// Sets the offset (`SetOffset`) and clears the two other offset registers.
pub fn offset_write<P: Vl53l1xPort>(p: P, mm: Int) -> Bool [hw]
    if mm < -1024 or mm > 1023
        return false
    wr16(p, REG_PART_OFFSET, (mm * 4) & 0xFFFF) and wr16(p, REG_INNER_OFFSET, 0) and wr16(p, REG_OUTER_OFFSET, 0)

// The crosstalk plane offset in counts a second: the register is kilo-counts in
// 7.9 fixed point.
pub fn xtalk_read<P: Vl53l1xPort>(p: P) -> ?Int [hw]
    let Some(v) = rd16(p, REG_XTALK_OFFSET) else return None
    Some((v * 1000) >> 9)

// Sets the crosstalk (`SetXtalk`): the two gradients cleared and the plane offset
// written.  The largest value the register holds is 127,998 counts a second.
pub fn xtalk_write<P: Vl53l1xPort>(p: P, cps: Int) -> Bool [hw]
    if cps < 0 or cps > 127998
        return false
    wr16(p, REG_XTALK_X, 0) and wr16(p, REG_XTALK_Y, 0) and wr16(p, REG_XTALK_OFFSET, (cps << 9) / 1000)

// Ranges `n` times and adds up the results that carry a distance (valid or
// weak): the sums, or `None` when the part stopped answering, a result did not
// come, or none of the `n` carried a distance.  Ranging is stopped at the end
// whatever happened.
pub fn sums_run<P: Vl53l1xPort>(p: P, n: Int) -> ?Vl53Sums [hw]
    var got = 0
    var dist = 0
    var signal = 0
    var spads = 0
    var ok = interrupt_clear(p) and ranging_start(p)
    for _k in 0..n
        if ok
            match result_wait(p)
                Some(r) =>
                    if status_of_raw(r.raw_status) == RangeStatus.RangeValid or status_of_raw(r.raw_status) == RangeStatus.RangeWeak
                        got = got + 1
                        dist = dist + r.range_mm
                        signal = signal + r.signal_kcps
                        spads = spads + r.spads
                None => ok = false
    let _stopped = ranging_stop(p)
    if not ok or got == 0
        return None
    Some(Vl53Sums { got: got, dist: dist, signal: signal, spads: spads })

// The offset calibration (`CalibrateOffset`): a target at `target_mm`, which UM2356
// § 3.2.2 asks to be a 17 % grey chart at 140 mm in the dark.  The offset
// registers are cleared, `CAL_RESULTS` results averaged, and the offset
// written.  Answers the offset in millimetres, or `None`.
// NOT VERIFIED on a part: the arithmetic is tested against hand-worked sums.
pub fn calibrate_offset<P: Vl53l1xPort>(p: P, target_mm: Int) -> ?Int [hw]
    if not (offset_write(p, 0))
        return None
    let Some(s) = sums_run(p, CAL_RESULTS) else return None
    let offset = target_mm - s.dist / s.got
    if not offset_write(p, offset)
        return None
    Some(offset)

// The crosstalk calibration (`CalibrateXtalk`): a target at `target_mm`, the
// distance the cover glass's ranging curve ends at (UM2356 § 3.3.3), in the
// dark.  The plane offset is cleared, results averaged, and the offset
// written as 512 times the average signal rate times one less the ratio of the
// average distance to the target, over the average SPAD count.  Answers the
// crosstalk in counts a second, or `None`.  A target of 0 and a part ranging
// beyond the target (a negative crosstalk) answer `None` and 0.
// NOT VERIFIED on a part, as the offset calibration.
pub fn calibrate_xtalk<P: Vl53l1xPort>(p: P, target_mm: Int) -> ?Int [hw]
    if target_mm <= 0
        return None
    if not wr16(p, REG_XTALK_OFFSET, 0)
        return None
    let Some(s) = sums_run(p, CAL_RESULTS) else return None
    if s.spads == 0
        return None
    var reg = 512 * s.signal * (s.got * target_mm - s.dist) / (s.got * target_mm * s.spads)
    if reg < 0
        reg = 0
    if reg > 0xFFFF
        reg = 0xFFFF
    if not wr16(p, REG_XTALK_OFFSET, reg)
        return None
    Some((reg * 1000) >> 9)

// ── The part on a board's I2C bus ────────────────────────────────────

// The part on a board's I2C bus: the bus, timer and GPIO handles the board
// gives, the wiring, and the state the driver keeps.
pub @value
struct Vl53l1x
    bus: BoardI2c
    timer: BoardTimer
    pins: BoardGpio
    w: DeviceWiring
    st: Vl53State

impl Vl53l1xPort for Vl53l1x
    fn setup(self) -> Bool [hw]
        i2c_setup(self.bus, self.pins, self.w)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        i2c_read_into(self.bus, self.w, reg, n, var dst)

    fn write_regs(self, reg: Int, src: DevBytes) -> Bool [hw]
        i2c_write_from(self.bus, self.w, reg, src)

    fn now_ms(self) -> Int [hw]
        self.timer.ticks_ms()

    fn wait_ms(self, ms: Int) [hw]
        self.timer.delay_ms(ms)

    fn irq_level(self) -> Int [hw]
        irq_level_of(self.pins, self.w)

    fn xshut(self, level: Int) -> Bool [hw]
        xshut_of(self.pins, self.w, level)

// The part with continuous ranging marked on or off, when the part took the
// start or the stop (`ok`), or as it was.
pub fn with_continuous(d: Vl53l1x, ok: Bool, on: Bool) -> Vl53l1x
    if not ok
        return d
    Vl53l1x { bus: d.bus, timer: d.timer, pins: d.pins, w: d.w, st: Vl53State { continuous: on } }

// The part at another address, when the part took the write (`ok`), or as it was.
pub fn with_addr(d: Vl53l1x, ok: Bool, addr: Int) -> Vl53l1x
    if not ok
        return d
    Vl53l1x { bus: d.bus, timer: d.timer, pins: d.pins, w: DeviceWiring { bus: d.w.bus, addr: Some(addr & 0x7F), cs: None, irq: d.w.irq, en: d.w.en }, st: d.st }

impl Vl53l1x
    // The part at `w.addr` on the board's I2C bus, as a board's device table
    // builds it.  Nothing is sent.  The wiring's `en` is XSHUT and its `irq` is
    // GPIO1.
    fn attach(bus: BoardI2c, timer: BoardTimer, pins: BoardGpio, w: DeviceWiring) -> Vl53l1x
        Vl53l1x { bus: bus, timer: timer, pins: pins, w: w, st: Vl53State { continuous: false } }

    // Brings the part up for breakouts with 2.8 V I/O (`bring_up`), after a cycle
    // of XSHUT when the wiring has the pin.  The part is in long mode with a
    // 100 ms budget.  Answers whether it came up.
    fn begin(self) -> Bool [hw]
        bring_up(self, true)

    // As `begin`, with the I/O level chosen: `false` leaves the pads at 1.8 V.
    fn begin_io(self, io_2v8: Bool) -> Bool [hw]
        bring_up(self, io_2v8)

    // The distance mode: `Some` for the two the driver sets.
    fn mode(self) -> ?Vl53Mode [hw]
        mode_read(self)

    fn set_mode(self, m: Vl53Mode) -> Bool [hw]
        mode_write(self, m)

    // The timing budget in milliseconds, 0 if the part does not answer.
    fn budget_ms(self) -> Int [hw]
        budget_read(self)

    fn set_budget_ms(self, ms: Int) -> Bool [hw]
        budget_write(self, ms)

    fn intermeasure_ms(self) -> Int [hw]
        intermeasure_read(self)

    fn set_intermeasure_ms(self, ms: Int) -> Bool [hw]
        intermeasure_write(self, ms)

    // Starts continuous ranging at the period set by `set_intermeasure_ms`.
    fn continuous_begin(var self) -> Bool [hw]
        let ok = interrupt_clear(self) and ranging_start(self)
        self = with_continuous(self, ok, true)
        ok

    // Stops continuous ranging.
    fn continuous_end(var self) -> Bool [hw]
        let ok = ranging_stop(self)
        self = with_continuous(self, ok, false)
        ok

    // One blocking measurement with every figure of the result.
    fn measure_now(self) -> ?Vl53Result [hw]
        measure(self)

    // The result of ranging that is running, with every figure.
    fn result_now(self) -> ?Vl53Result [hw]
        result_wait(self)

    fn data_ready(self) -> Bool [hw]
        data_ready(self)

    fn set_interrupt_high(self, high: Bool) -> Bool [hw]
        polarity_write(self, high)

    fn interrupt_high(self) -> ?Bool [hw]
        polarity_read(self)

    // The level of GPIO1, -1 without a pin in the wiring.
    fn gpio1_level(self) -> Int [hw]
        self.irq_level()

    fn roi(self) -> ?Vl53Roi [hw]
        roi_read(self)

    // The region from a size, with the centre the ultra-lite driver picks.
    fn set_roi_size(self, w: Int, h: Int) -> Bool [hw]
        roi_size_write(self, w, h)

    fn set_roi(self, r: Vl53Roi) -> Bool [hw]
        roi_write(self, r)

    fn offset_mm(self) -> ?Int [hw]
        offset_read(self)

    fn set_offset_mm(self, mm: Int) -> Bool [hw]
        offset_write(self, mm)

    fn xtalk_cps(self) -> ?Int [hw]
        xtalk_read(self)

    fn set_xtalk_cps(self, cps: Int) -> Bool [hw]
        xtalk_write(self, cps)

    // The calibrations; the results are NOT VERIFIED on a part.
    fn calibrate_offset(self, target_mm: Int) -> ?Int [hw]
        calibrate_offset(self, target_mm)

    fn calibrate_xtalk(self, target_mm: Int) -> ?Int [hw]
        calibrate_xtalk(self, target_mm)

    fn temperature_update(self) -> Bool [hw]
        temperature_update(self)

    fn signal_limit_kcps(self) -> Int [hw]
        signal_limit_read(self)

    fn set_signal_limit_kcps(self, kcps: Int) -> Bool [hw]
        signal_limit_write(self, kcps)

    fn sigma_limit_mm(self) -> Int [hw]
        sigma_limit_read(self)

    fn set_sigma_limit_mm(self, mm: Int) -> Bool [hw]
        sigma_limit_write(self, mm)

    // Arms the distance threshold interrupt.
    fn set_threshold(self, low: Int, high: Int, w: Vl53Window, no_target: Bool) -> Bool [hw]
        threshold_write(self, low, high, w, no_target)

    fn set_interrupt_new_sample(self) -> Bool [hw]
        interrupt_new_sample(self)

    // Moves the part to another I2C address, which it keeps until the next
    // power-up or XSHUT, and follows it: whether the part took the write.
    fn move_to(var self, addr: Int) -> Bool [hw]
        let ok = wr(self, REG_I2C_ADDRESS, addr & 0x7F)
        self = with_addr(self, ok, addr)
        ok

    // One register, for the registers this driver does not name.
    fn reg(self, r: Int) -> ?Int [hw]
        rd(self, r)

impl Rangefinder[hw] for Vl53l1x
    // Starts ranging and answers the budget in microseconds, the time one
    // result takes; for continuous ranging the answer is 0 and nothing is
    // started.  A negative answer is a part that did not take the start.
    fn range_start(self) -> Int [hw]
        range_start_of(self, self.st)

    // Waits for the result, at most 1.1 s, and reads it: `None` when the part
    // did not answer or no result came.  A measurement started by
    // `range_start` is stopped after its result.
    fn range_read(self) -> ?RangeReading [hw]
        range_read_of(self, self.st)

    fn range_max_mm(self) -> Int [hw]
        max_mm_of(self)

impl RangefinderZones[hw] for Vl53l1x
    fn zones_side(self) -> Int [hw]
        ZONE_SIDE

    // The time a scan takes in microseconds, 16 budgets, or -1 when the part
    // does not answer or ranges continuously.  The scan itself is `zones_read`.
    fn zones_start(self) -> Int [hw]
        zones_start_of(self, self.st)

    fn zones_read(self, var out: Vec[RangeReading; 64]) -> Bool [hw]
        zones_read_of(self, self.st, var out)

impl Identifiable[hw] for Vl53l1x
    // The model ID and module type, 0xEACC, and the mask revision register.
    fn device_id(self) -> ?DeviceId [hw]
        id_read(self)
