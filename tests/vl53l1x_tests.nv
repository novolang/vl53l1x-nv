@test
fn test_every_raw_status_maps_to_a_range_status_with_or_without_a_distance() [io, hw]
    test.assert(vl53l1x.status_of_raw(9) == RangeStatus.RangeValid)
    test.assert(vl53l1x.status_of_raw(6) == RangeStatus.RangeWeak)
    test.assert(vl53l1x.status_of_raw(4) == RangeStatus.RangeWeak)
    test.assert(vl53l1x.status_of_raw(5) == RangeStatus.RangeOutOfRange)
    test.assert(vl53l1x.status_of_raw(7) == RangeStatus.RangeOutOfRange)
    test.assert(vl53l1x.status_of_raw(8) == RangeStatus.RangeOutOfRange)
    test.assert(vl53l1x.status_of_raw(1) == RangeStatus.RangeFault)
    test.assert(vl53l1x.status_of_raw(2) == RangeStatus.RangeFault)
    test.assert(vl53l1x.status_of_raw(3) == RangeStatus.RangeFault)
    test.assert(vl53l1x.status_of_raw(17) == RangeStatus.RangeFault)
    test.assert(vl53l1x.status_of_raw(12) == RangeStatus.RangeNoTarget)
    test.assert(vl53l1x.status_of_raw(13) == RangeStatus.RangeNoTarget)
    test.assert(vl53l1x.status_of_raw(18) == RangeStatus.RangeNoTarget)
    test.assert(vl53l1x.status_of_raw(0) == RangeStatus.RangeNoTarget)
    let ok = vl53l1x.reading_of(9, 291)
    test.assert_eq(ok.mm, 291)
    test.assert(ok.status == RangeStatus.RangeValid)
    let faint = vl53l1x.reading_of(4, 1500)
    test.assert_eq(faint.mm, 1500)
    test.assert(faint.status == RangeStatus.RangeWeak)
    let far = vl53l1x.reading_of(7, 1500)
    test.assert_eq(far.mm, 0)
    test.assert(far.status == RangeStatus.RangeOutOfRange)
    test.assert_eq(vl53l1x.reading_of(2, 40).mm, 0)

@test
fn test_the_status_numbers_of_the_ultra_lite_driver() [io, hw]
    test.assert_eq(vl53l1x.uld_status_of_raw(9), 0)
    test.assert_eq(vl53l1x.uld_status_of_raw(6), 1)
    test.assert_eq(vl53l1x.uld_status_of_raw(4), 2)
    test.assert_eq(vl53l1x.uld_status_of_raw(8), 3)
    test.assert_eq(vl53l1x.uld_status_of_raw(5), 4)
    test.assert_eq(vl53l1x.uld_status_of_raw(3), 5)
    test.assert_eq(vl53l1x.uld_status_of_raw(19), 6)
    test.assert_eq(vl53l1x.uld_status_of_raw(7), 7)
    test.assert_eq(vl53l1x.uld_status_of_raw(12), 9)
    test.assert_eq(vl53l1x.uld_status_of_raw(18), 10)
    test.assert_eq(vl53l1x.uld_status_of_raw(22), 11)
    test.assert_eq(vl53l1x.uld_status_of_raw(23), 12)
    test.assert_eq(vl53l1x.uld_status_of_raw(13), 13)
    test.assert_eq(vl53l1x.uld_status_of_raw(1), 255)

@test
fn test_the_result_block_is_read_in_one_transaction_and_decoded() [io, hw]
    let c = chip()
    put(c, 0x0089, 0xE9)
    put(c, 0x008B, 7)
    let d = dut(c)
    let r = vl53l1x.result_read(d)
    log_is(c, [2, 0x0089, 17, -1, 1, 0x0086, 0x01, -1])
    match r
        Some(x) =>
            test.assert_eq(x.raw_status, 9)
            test.assert_eq(x.stream, 7)
            test.assert_eq(x.spads, 20)
            test.assert_eq(x.ambient_kcps, 800)
            test.assert_eq(x.signal_kcps, 4800)
            test.assert_eq(x.range_mm, 291)
        None => test.assert(false)

@test
fn test_a_result_read_fails_when_the_block_or_the_clear_fails() [io, hw]
    let c = chip()
    c.st.insert(2, 1)
    test.assert(vl53l1x.result_read(dut(c)) == None)
    let c2 = chip()
    c2.st.insert(2, 2)
    test.assert(vl53l1x.result_read(dut(c2)) == None)

@test
fn test_waiting_for_a_result_gives_up_after_1_1_s() [io, hw]
    let c = chip()
    c.st.insert(23, 1)
    c.st.insert(21, 1)
    test.assert(vl53l1x.result_wait(dut(c)) == None)
    test.assert(at(c.st, 0) >= 1100)

@test
fn test_one_measurement_clears_starts_waits_reads_and_stops() [io, hw]
    let c = started()
    let r = vl53l1x.measure(dut(c))
    match r
        Some(x) => test.assert_eq(x.range_mm, 291)
        None => test.assert(false)
    // clear, start, then the flag, the block, clear and stop.
    test.assert_eq(at(c.log, 0), 1)
    test.assert_eq(at(c.log, 1), 0x0086)
    test.assert_eq(at(c.log, 4), 1)
    test.assert_eq(at(c.log, 5), 0x0087)
    test.assert_eq(at(c.log, 6), 0x40)
    test.assert_eq(at(c.regs, 0x0087), 0x00)
    test.assert_eq(at(c.st, 24), 0)

@test
fn test_a_measurement_that_never_finishes_is_stopped_and_answers_nothing() [io, hw]
    let c = started()
    c.st.insert(21, 1)
    test.assert(vl53l1x.measure(dut(c)) == None)
    test.assert_eq(at(c.st, 24), 0)
    let c2 = chip()
    c2.st.insert(4, 0)
    test.assert(vl53l1x.measure(dut(c2)) == None)

