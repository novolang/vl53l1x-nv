@test
fn test_range_start_answers_the_budget_or_zero_while_continuous() [io, hw]
    let c = started()
    let d = dut(c)
    test.assert_eq(vl53l1x.range_start_of(d, Vl53State { continuous: false }), 100000)
    test.assert_eq(at(c.st, 24), 1)
    log_clear(c)
    test.assert_eq(vl53l1x.range_start_of(d, Vl53State { continuous: true }), 0)
    test.assert_eq(at(c.st, 99), 0)

@test
fn test_range_start_answers_the_longest_budget_for_a_budget_it_does_not_know() [io, hw]
    let c = started()
    put16(c, 0x005E, 0x1111)
    test.assert_eq(vl53l1x.range_start_of(dut(c), Vl53State { continuous: false }), 500000)

@test
fn test_range_start_answers_minus_one_when_a_transaction_fails() [io, hw]
    for k in 1..3
        let c = started()
        c.st.insert(2, k)
        test.assert_eq(vl53l1x.range_start_of(dut(c), Vl53State { continuous: false }), -1)

@test
fn test_range_read_waits_reads_and_stops_a_single_measurement() [io, hw]
    let c = started()
    let d = dut(c)
    test.assert(vl53l1x.range_start_of(d, Vl53State { continuous: false }) > 0)
    let r = vl53l1x.range_read_of(d, Vl53State { continuous: false })
    test.assert_eq(mm_of(r), 291)
    test.assert(status_of(r) == RangeStatus.RangeValid)
    test.assert_eq(at(c.st, 24), 0)

@test
fn test_range_read_leaves_continuous_ranging_running() [io, hw]
    let c = started()
    let d = dut(c)
    test.assert(vl53l1x.ranging_start(d))
    let r = vl53l1x.range_read_of(d, Vl53State { continuous: true })
    test.assert_eq(mm_of(r), 291)
    test.assert_eq(at(c.st, 24), 1)
    // The next result is pending again after the clear.
    test.assert_eq(at(c.st, 23), 1)

@test
fn test_range_read_reports_the_status_of_a_target_it_cannot_measure() [io, hw]
    let c = started()
    put(c, 0x0089, 7)
    let d = dut(c)
    test.assert(vl53l1x.range_start_of(d, Vl53State { continuous: false }) > 0)
    let r = vl53l1x.range_read_of(d, Vl53State { continuous: false })
    test.assert_eq(mm_of(r), 0)
    test.assert(status_of(r) == RangeStatus.RangeOutOfRange)

@test
fn test_range_read_answers_nothing_when_no_result_comes_and_still_stops() [io, hw]
    let c = started()
    c.st.insert(21, 1)
    let d = dut(c)
    test.assert(vl53l1x.range_start_of(d, Vl53State { continuous: false }) > 0)
    test.assert(vl53l1x.range_read_of(d, Vl53State { continuous: false }) == None)
    test.assert_eq(at(c.st, 24), 0)

@test
fn test_the_longest_distance_follows_the_mode() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert_eq(vl53l1x.max_mm_of(d), 3600)
    put(c, 0x004B, 0x14)
    test.assert_eq(vl53l1x.max_mm_of(d), 1360)
    put(c, 0x004B, 0x00)
    test.assert_eq(vl53l1x.max_mm_of(d), 0)
    c.st.insert(4, 0)
    test.assert_eq(vl53l1x.max_mm_of(d), 0)

// ── The zones ────────────────────────────────────────────────────────

// The centre SPAD of every region write to 0x7F in the log, in order.
fn roi_centres(c: Chip) -> [Int]
    var out: [Int] = []
    let n = at(c.st, 99)
    for i in 0..n
        if at(c.log, i) == 1 and at(c.log, i + 1) == 0x007F
            list.push(out, at(c.log, i + 2))
    out

@test
fn test_a_scan_measures_16_regions_of_4_by_4_row_by_row() [io, hw]
    let c = started()
    var out: Vec[RangeReading; 64] = Vec.new()
    test.assert(vl53l1x.zones_scan(dut(c), var out))
    test.assert_eq(out.len(), 16)
    for i in 0..16
        test.assert_eq(out[i].mm, 291)
        test.assert(out[i].status == RangeStatus.RangeValid)
    // The centres: column 4 col + 2, row 4 row + 1 of the table of the array,
    // then the region the part had put back (centre 199, 16 by 16).
    let want = [145, 177, 209, 241, 149, 181, 213, 245, 110, 78, 46, 14, 106, 74, 42, 10, 199]
    let got = roi_centres(c)
    test.assert_eq(got.len(), 17)
    for i in 0..17
        test.assert_eq(got[i], want[i])
    test.assert_eq(at(c.regs, 0x007F), 199)
    test.assert_eq(at(c.regs, 0x0080), 0xFF)
    test.assert_eq(at(c.st, 24), 0)

@test
fn test_a_scan_that_cannot_measure_leaves_nothing_and_puts_the_region_back() [io, hw]
    let c = started()
    c.st.insert(21, 1)
    var out: Vec[RangeReading; 64] = Vec.new()
    let _ = out.push(RangeReading { mm: 1, status: RangeStatus.RangeValid })
    test.assert(not vl53l1x.zones_scan(dut(c), var out))
    test.assert_eq(out.len(), 0)
    test.assert_eq(at(c.regs, 0x007F), 199)
    test.assert_eq(at(c.regs, 0x0080), 0xFF)

@test
fn test_a_scan_fails_on_any_one_failed_transaction_with_nothing_in_the_output() [io, hw]
    let c = started()
    var good: Vec[RangeReading; 64] = Vec.new()
    test.assert(vl53l1x.zones_scan(dut(c), var good))
    let n = at(c.st, 1)
    // A failed stop is not a failed scan (the result was read), nor is a poll
    // the part did not answer.  Every other transaction fails the scan, and the
    // output is empty.
    var failed = 0
    for k in 1..(n + 1)
        let c2 = started()
        c2.st.insert(2, k)
        var out: Vec[RangeReading; 64] = Vec.new()
        if not vl53l1x.zones_scan(dut(c2), var out)
            failed = failed + 1
            test.assert_eq(out.len(), 0)
    test.assert_eq(failed, n - 16 - polls_in(c))

@test
fn test_the_zone_trait_answers_the_grid_side_and_the_scan_time() [io, hw]
    let c = started()
    let d = dut(c)
    test.assert_eq(vl53l1x.zones_start_of(d, Vl53State { continuous: false }), 1600000)
    test.assert_eq(vl53l1x.zones_start_of(d, Vl53State { continuous: true }), -1)
    c.st.insert(4, 0)
    test.assert_eq(vl53l1x.zones_start_of(d, Vl53State { continuous: false }), -1)

@test
fn test_a_scan_is_refused_while_the_part_ranges_continuously() [io, hw]
    let c = started()
    var out: Vec[RangeReading; 64] = Vec.new()
    let _ = out.push(RangeReading { mm: 1, status: RangeStatus.RangeValid })
    test.assert(not vl53l1x.zones_read_of(dut(c), Vl53State { continuous: true }, var out))
    test.assert_eq(out.len(), 0)
    test.assert_eq(at(c.st, 99), 0)
    test.assert(vl53l1x.zones_read_of(dut(c), Vl53State { continuous: false }, var out))
    test.assert_eq(out.len(), 16)

// ── The calibrations ─────────────────────────────────────────────────

@test
fn test_the_offset_has_two_fraction_bits_in_13_bits_two_s_complement() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(vl53l1x.offset_write(d, -5))
    test.assert_eq(at(c.regs, 0x001E), 0xFF)
    test.assert_eq(at(c.regs, 0x001F), 0xEC)
    test.assert_eq(at(c.regs, 0x0020), 0)
    test.assert_eq(at(c.regs, 0x0023), 0)
    test.assert(vl53l1x.offset_read(d) == Some(-5))
    test.assert(vl53l1x.offset_write(d, 7))
    test.assert_eq(at(c.regs, 0x001F), 0x1C)
    test.assert(vl53l1x.offset_read(d) == Some(7))
    test.assert(not vl53l1x.offset_write(d, 1024))
    test.assert(not vl53l1x.offset_write(d, -1025))
    test.assert(vl53l1x.offset_write(d, 1023))
    test.assert(vl53l1x.offset_write(d, -1024))
    c.st.insert(4, 0)
    test.assert(vl53l1x.offset_read(d) == None)
    test.assert(not vl53l1x.offset_write(d, 7))

@test
fn test_a_fractional_offset_reads_toward_zero_as_c_divides() [io, hw]
    let c = chip()
    put16(c, 0x001E, 0x1FF9)
    test.assert(vl53l1x.offset_read(dut(c)) == Some(-1))
    put16(c, 0x001E, 0x1FFD)
    test.assert(vl53l1x.offset_read(dut(c)) == Some(0))
    put16(c, 0x001E, 0x0007)
    test.assert(vl53l1x.offset_read(dut(c)) == Some(1))
    test.assert_eq(vl53l1x.div_trunc(-7, 4), -1)
    test.assert_eq(vl53l1x.div_trunc(7, 4), 1)

@test
fn test_the_crosstalk_is_kilocounts_in_7_9_fixed_point() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(vl53l1x.xtalk_write(d, 5000))
    test.assert_eq(at(c.regs, 0x0016), 0x0A)
    test.assert_eq(at(c.regs, 0x0017), 0x00)
    test.assert_eq(at(c.regs, 0x0018), 0)
    test.assert_eq(at(c.regs, 0x001B), 0)
    test.assert(vl53l1x.xtalk_read(d) == Some(5000))
    test.assert(vl53l1x.xtalk_write(d, 127998))
    test.assert_eq(at(c.regs, 0x0016), 0xFF)
    test.assert(not vl53l1x.xtalk_write(d, 127999))
    test.assert(not vl53l1x.xtalk_write(d, -1))
    c.st.insert(4, 0)
    test.assert(vl53l1x.xtalk_read(d) == None)
    test.assert(not vl53l1x.xtalk_write(d, 5))

@test
fn test_the_sums_count_only_results_that_carry_a_distance() [io, hw]
    let c = started()
    match vl53l1x.sums_run(dut(c), 3)
        Some(s) =>
            test.assert_eq(s.got, 3)
            test.assert_eq(s.dist, 873)
            test.assert_eq(s.signal, 14400)
            test.assert_eq(s.spads, 60)
        None => test.assert(false)
    test.assert_eq(at(c.st, 24), 0)
    let c2 = started()
    c2.st.insert(40, 1)
    match vl53l1x.sums_run(dut(c2), 4)
        Some(s) => test.assert_eq(s.got, 2)
        None => test.assert(false)

@test
fn test_the_sums_are_nothing_without_a_distance_or_a_result_or_a_start() [io, hw]
    let c = started()
    put(c, 0x0089, 12)
    test.assert(vl53l1x.sums_run(dut(c), 3) == None)
    test.assert_eq(at(c.st, 24), 0)
    let c2 = started()
    c2.st.insert(21, 1)
    test.assert(vl53l1x.sums_run(dut(c2), 3) == None)
    test.assert_eq(at(c2.st, 24), 0)
    let c3 = started()
    c3.st.insert(2, 1)
    test.assert(vl53l1x.sums_run(dut(c3), 3) == None)

@test
fn test_the_offset_calibration_sets_the_target_less_the_average() [io, hw]
    // The part reads 291 mm of a target at 140 mm: the offset is -151.
    let c = started()
    let d = dut(c)
    test.assert(vl53l1x.calibrate_offset(d, 140) == Some(-151))
    test.assert(vl53l1x.offset_read(d) == Some(-151))
    let c2 = started()
    test.assert(vl53l1x.calibrate_offset(dut(c2), 300) == Some(9))
    test.assert_eq(at(c2.regs, 0x001F), 36)

@test
fn test_the_offset_calibration_fails_without_results_or_on_a_failed_write() [io, hw]
    let c = started()
    c.st.insert(21, 1)
    test.assert(vl53l1x.calibrate_offset(dut(c), 140) == None)
    let c2 = started()
    c2.st.insert(2, 1)
    test.assert(vl53l1x.calibrate_offset(dut(c2), 140) == None)
    // The last transaction of a good run is the write that sets the offset.
    let c3 = started()
    test.assert(vl53l1x.calibrate_offset(dut(c3), 140) != None)
    let n = at(c3.st, 1)
    let c4 = started()
    c4.st.insert(2, n)
    test.assert(vl53l1x.calibrate_offset(dut(c4), 140) == None)

@test
fn test_the_crosstalk_calibration_follows_the_ultra_lite_formula() [io, hw]
    // 50 results of 300 mm, signal 80 kcps (raw 10), 20 SPADs, a target at
    // 600 mm: 512 * (50 * 80) * (50 * 600 - 50 * 300) / (50 * 600 * 50 * 20) = 1024,
    // which is 2000 counts a second.
    let c = started()
    put16(c, 0x0096, 300)
    put16(c, 0x0098, 10)
    test.assert(vl53l1x.calibrate_xtalk(dut(c), 600) == Some(2000))
    test.assert_eq(at(c.regs, 0x0016), 0x04)
    test.assert_eq(at(c.regs, 0x0017), 0x00)

@test
fn test_a_target_nearer_than_the_average_gives_no_crosstalk() [io, hw]
    let c = started()
    put16(c, 0x0096, 700)
    put16(c, 0x0098, 10)
    test.assert(vl53l1x.calibrate_xtalk(dut(c), 600) == Some(0))

@test
fn test_a_very_strong_signal_clips_the_crosstalk_to_the_register() [io, hw]
    let c = started()
    put16(c, 0x0096, 0)
    put16(c, 0x0098, 0xFFFF)
    test.assert(vl53l1x.calibrate_xtalk(dut(c), 600) == Some(127998))
    test.assert_eq(at(c.regs, 0x0016), 0xFF)

@test
fn test_the_crosstalk_calibration_fails_for_bad_input_and_failed_transactions() [io, hw]
    let c = started()
    test.assert(vl53l1x.calibrate_xtalk(dut(c), 0) == None)
    test.assert(vl53l1x.calibrate_xtalk(dut(c), -5) == None)
    let c2 = started()
    put16(c2, 0x008C, 0)
    test.assert(vl53l1x.calibrate_xtalk(dut(c2), 600) == None)
    let c3 = started()
    c3.st.insert(2, 1)
    test.assert(vl53l1x.calibrate_xtalk(dut(c3), 600) == None)
    let c4 = started()
    c4.st.insert(21, 1)
    test.assert(vl53l1x.calibrate_xtalk(dut(c4), 600) == None)
    let c5 = started()
    put16(c5, 0x0096, 300)
    put16(c5, 0x0098, 10)
    test.assert(vl53l1x.calibrate_xtalk(dut(c5), 600) != None)
    let n = at(c5.st, 1)
    let c6 = started()
    put16(c6, 0x0096, 300)
    put16(c6, 0x0098, 10)
    c6.st.insert(2, n)
    test.assert(vl53l1x.calibrate_xtalk(dut(c6), 600) == None)

// ── The types and the helpers that carry the state ───────────────────

@test
fn test_the_state_helpers() [io, hw]
    let d = Vl53l1x.attach(BoardI2c { id: 0 }, BoardTimer { id: 0 }, BoardGpio { id: 0 }, wiring())
    test.assert(not d.st.continuous)
    let on = vl53l1x.with_continuous(d, true, true)
    test.assert(on.st.continuous)
    let still = vl53l1x.with_continuous(d, false, true)
    test.assert(not still.st.continuous)
    let off = vl53l1x.with_continuous(on, true, false)
    test.assert(not off.st.continuous)
    let moved = vl53l1x.with_addr(on, true, 0x30)
    test.assert(moved.w.addr == Some(0x30))
    test.assert(moved.w.irq == Some(7))
    test.assert(moved.w.en == Some(8))
    test.assert(moved.st.continuous)
    let stayed = vl53l1x.with_addr(d, false, 0x30)
    test.assert(stayed.w.addr == Some(0x29))

@test
fn test_moving_the_address_writes_0x0001_and_the_part_answers_there() [io, hw]
    let c = chip()
    let d = dut(c)
    test.assert(vl53l1x.wr(d, 0x0001, 0x30))
    test.assert_eq(at(c.st, 30), 0x30)
    test.assert(vl53l1x.rd(d, 0x010F) == None)
    let moved = Dut { bus: FakeI2c { c: c }, pins: pins(c), c: c, w: dev_bus.wiring_i2c(0, 0x30) }
    test.assert(vl53l1x.model_ok(moved))

// ── The type over the host's board handles ───────────────────────────
//
// The host's I2C bus is absent hardware: every transfer is refused, so each
// method answers its "no part" value.  This runs the lines of the type that
// forward to the functions above.

@test
fn test_the_type_over_absent_hardware() [io, hw]
    var p = Vl53l1x.attach(BoardI2c { id: 0 }, BoardTimer { id: 0 }, BoardGpio { id: 0 }, wiring())
    test.assert(not p.begin())
    test.assert(not p.begin_io(false))
    test.assert(p.mode() == None)
    test.assert(not p.set_mode(Vl53Mode.Vl53Long))
    test.assert_eq(p.budget_ms(), 0)
    test.assert(not p.set_budget_ms(50))
    test.assert_eq(p.intermeasure_ms(), 0)
    test.assert(not p.set_intermeasure_ms(100))
    test.assert(not p.continuous_begin())
    test.assert(not p.continuous_end())
    test.assert(p.measure_now() == None)
    test.assert(p.result_now() == None)
    test.assert(not p.data_ready())
    test.assert(not p.set_interrupt_high(true))
    test.assert(p.interrupt_high() == None)
    test.assert_eq(p.gpio1_level(), 0)
    test.assert(p.roi() == None)
    test.assert(not p.set_roi_size(8, 8))
    test.assert(not p.set_roi(Vl53Roi { w: 8, h: 8, centre: 199 }))
    test.assert(p.offset_mm() == None)
    test.assert(not p.set_offset_mm(3))
    test.assert(p.xtalk_cps() == None)
    test.assert(not p.set_xtalk_cps(3))
    test.assert(p.calibrate_offset(140) == None)
    test.assert(p.calibrate_xtalk(600) == None)
    test.assert(not p.temperature_update())
    test.assert_eq(p.signal_limit_kcps(), -1)
    test.assert(not p.set_signal_limit_kcps(1024))
    test.assert_eq(p.sigma_limit_mm(), -1)
    test.assert(not p.set_sigma_limit_mm(15))
    test.assert(not p.set_threshold(10, 20, Vl53Window.WindowIn, false))
    test.assert(not p.set_interrupt_new_sample())
    test.assert(not p.move_to(0x30))
    test.assert(p.reg(0x010F) == None)
    test.assert_eq(p.range_start(), -1)
    test.assert(p.range_read() == None)
    test.assert_eq(p.range_max_mm(), 0)
    test.assert(p.device_id() == None)
    test.assert(p.range_read_after(10, 20) == None)
    test.assert_eq(p.zones_side(), 4)
    test.assert_eq(p.zones_start(), -1)
    var out: Vec[RangeReading; 64] = Vec.new()
    test.assert(not p.zones_read(var out))

@test
fn test_the_type_without_pins_over_absent_hardware() [io, hw]
    var p = Vl53l1x.attach(BoardI2c { id: 0 }, BoardTimer { id: 0 }, BoardGpio { id: 0 }, wiring_plain())
    test.assert(not p.begin())
    test.assert_eq(p.gpio1_level(), -1)

@test
fn test_the_type_while_continuous_over_absent_hardware() [io, hw]
    let d = vl53l1x.with_continuous(Vl53l1x.attach(BoardI2c { id: 0 }, BoardTimer { id: 0 }, BoardGpio { id: 0 }, wiring()), true, true)
    test.assert_eq(d.range_start(), 0)
    test.assert_eq(d.zones_start(), -1)
    var out: Vec[RangeReading; 64] = Vec.new()
    test.assert(not d.zones_read(var out))

// A function written against the trait alone, called on a `let`.
fn distance_of<R: Rangefinder>(r: R) -> ?RangeReading [hw]
    if r.range_start() < 0
        return None
    r.range_read()

@test
fn test_a_function_over_the_trait_reads_the_sensor_through_a_plain_parameter() [io, hw]
    let p = Vl53l1x.attach(BoardI2c { id: 0 }, BoardTimer { id: 0 }, BoardGpio { id: 0 }, wiring())
    test.assert(distance_of(p) == None)
