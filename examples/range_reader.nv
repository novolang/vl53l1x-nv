/* range_reader.nv: a reading loop that prints the distance a VL53L1X
 * time-of-flight sensor measures, about five times a second, and a 4 by 4
 * map of the field of view once in ten readings
 *
 * Build:  bash tests/device_build.sh   (the package's own script)
 *          or make this file the main of a package that depends on
 *          vl53l1x-nv and run
 *              novo build --target=nrf52840-dk src/main.nv
 * Run:    probe-rs run --chip nRF52840_xxAA main.elf
 *
 * NOT a `novo run` program: it targets a board and never ends.
 *
 * The sensor is a VL53L1X on a breakout (Adafruit 3967, SparkFun SEN-14722,
 * Pololu 3415, Pimoroni, M5Stack): SDA and SCL to the board's first I2C bus,
 * power to 3.3 V and ground, and XSHUT and GPIO1 left open or wired to pins
 * the program does not use.  The part answers at 0x29.  A line looks like
 *
 *     range 1234 mm
 *     out of range
 *
 * and the map is four lines of four distances in millimetres, 0 for a zone
 * with no distance.
 *
 * The program reads the sensor through devices-nv's Rangefinder trait:
 * `range_start` starts a measurement and answers the time it takes in
 * microseconds, and `range_read` waits for the result and answers the
 * distance with its status.  The map is `RangefinderZones.zones_read`.
 *
 * Effects the program declares: [hw], for the I2C bus, the UART and the
 * timer.  It allocates nothing after it starts.
 *
 * Boards: the nRF52840 DK and the nRF54LM20 DK build this program, but
 * neither board has a driver for its two-wire interface yet (TWIM), so
 * `BoardI2c` is absent hardware there and the program prints "no answer"
 * until a board package names one with `@hal(i2c)`.  No board on the bench
 * carries the sensor; it has not been read on a board.
 */
use embedded_hal.{ BoardI2c, BoardGpio, BoardTimer }
use dev_range.{ RangeReading, Rangefinder, RangefinderZones }
use dev_bus
use vl53l1x.{ Vl53l1x, Vl53Mode }

// Writes `n`, 0 or more, in decimal.  Formatting into a string would
// allocate, which @tier(embedded) refuses, so each digit goes out as a
// byte.  An Int has at most 19 decimal digits, which bounds both loops.
@tier(embedded)
fn digits(n: Int) [hw]
    var div = 1
    for _k in 0..18
        if div <= n / 10
            div = div * 10
    for _k in 0..19
        if div > 0
            hal.uart.write_byte(48 + (n / div) % 10)
            div = div / 10

// Writes the line for a reading.
@tier(embedded)
fn report(r: RangeReading) [hw]
    match r.status
        RangeValid =>
            hal.uart.write("range ")
            digits(r.mm)
            hal.uart.write(" mm\n")
        RangeWeak =>
            hal.uart.write("weak ")
            digits(r.mm)
            hal.uart.write(" mm\n")
        RangeOutOfRange => hal.uart.write("out of range\n")
        RangeNoTarget => hal.uart.write("no target\n")
        RangeFault => hal.uart.write("sensor fault\n")

// Writes the 4 by 4 map, one line a row.
@tier(embedded)
fn map(zones: Vec[RangeReading; 64]) [hw]
    for row in 0..4
        for col in 0..4
            digits(zones[row * 4 + col].mm)
            hal.uart.write(" ")
        hal.uart.write("\n")

@tier(embedded)
fn main() [hw]
    bsp.board.init()
    var sensor = Vl53l1x.attach(BoardI2c { id: 0 }, BoardTimer { id: 0 }, BoardGpio { id: 0 },
                                dev_bus.wiring_i2c(0, 0x29))
    // The sensor needs 1.2 ms after its supply; the program waits 5.
    hal.timer.delay_ms(5)
    if not sensor.begin()
        hal.uart.write("no answer from the sensor at 0x29\n")
    let _ = sensor.set_mode(Vl53Mode.Vl53Long)
    let _ = sensor.set_budget_ms(100)
    var zones: Vec[RangeReading; 64] = Vec.new()
    var tick = 0
    while true
        if sensor.range_start() < 0
            hal.uart.write("no answer\n")
        else
            match sensor.range_read()
                Some(r) => report(r)
                None => hal.uart.write("no answer\n")
        tick = tick + 1
        if tick % 10 == 0
            if sensor.zones_read(var zones)
                map(zones)
        hal.timer.delay_ms(100)
